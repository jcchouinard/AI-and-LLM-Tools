{
  "_label": "Locked down to this folder",
  "_git": true,
  "_pr_gate": true,
  "_lockdown": true,
  "_disable_user_plugins": true,
  "_launch": [
    "--setting-sources",
    "project,local",
    "--strict-mcp-config",
    "--model",
    "sonnet",
    "--effort",
    "medium",
    "--disable-slash-commands",
    "--tools",
    "Bash,Read,Edit,Write,Agent",
    "--permission-mode",
    "dontAsk"
  ],
  "_claude_md_rules": [
    "Read narrowly: grep first, then Read with offset/limit. For files over 350 lines use the file-summarizer subagent.",
    "You are confined to this folder and to the commands in .claude/lockdown.json. When something is blocked, say what you need and stop. Do not look for workarounds.",
    "Push, PR, network and installs are done by the user, not you."
  ],
  "model": "sonnet",
  "effortLevel": "medium",
  "enableArtifact": false,
  "disableClaudeAiConnectors": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "Agent"
    ],
    "deny": [
      "mcp__*",
      "Workflow",
      "DesignSync",
      "Monitor",
      "WebSearch",
      "WebFetch",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.git/**)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": []
    }
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  }
}
